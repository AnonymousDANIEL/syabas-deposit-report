# Syabas99
SITE_API_URL=https://jksyab99.u55y38.com/api/v1/index.php
SITE_USERNAME=YOUR_USERNAME
SITE_PASSWORD=YOUR_NEW_PASSWORD
SITE_MERCHANT_ID=YOUR_MERCHANT_ID

# Optional: only fill these if login requires them.
SITE_TRACKING_CODE=
SITE_PASSCODE_2FA=
SITE_CAPTCHA_OUTPUT=

# Telegram
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
TELEGRAM_CHAT_ID=-1001234567890
# Optional separate admin/error destination. Leave blank to disable error alerts.
TELEGRAM_ALERT_CHAT_ID=

# Report values - can be changed anytime without changing code
TARGET_COUNT=8300
TARGET_DEPOSIT=100000
REPORT_TIMEZONE=Asia/Kuala_Lumpur

# full  = "0100 - 211 | RM 5,854.19 | TOTAL: 211 / RM 5,854.19"
# simple= "0100 - 211 | RM 5,854.19"
REPORT_LINE_STYLE=full

# Railway persistent volume: mount a volume at /data
STATE_PATH=/data/syabas_state.json

# Reliability
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3
VALIDATION_RETRIES=3
VALIDATION_RETRY_DELAY_SECONDS=4
STRICT_FINAL_DAILY_VALIDATION=false
SHOW_VALIDATION_STATUS=false
DRY_RUN=false

# Watchdog/stuck-job protection
JOB_TIMEOUT_SECONDS=240
FORCE_RUN=false
