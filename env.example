# Syabas99
SITE_API_URL=https://jksyab99.u55y38.com/api/v1/index.php
SITE_LOGIN_URL=https://jksyab99.u55y38.com/
SITE_USERNAME=YOUR_USERNAME
SITE_PASSWORD=YOUR_PASSWORD
SITE_MERCHANT_ID=10776

# Dynamic trackingCode login
# true = open the real login page in headless Chromium and let Syabas99
# generate the latest trackingCode automatically on every login/re-login.
AUTO_TRACKING_CODE=true
BROWSER_LOGIN_TIMEOUT_SECONDS=30

# Leave SITE_TRACKING_CODE empty when AUTO_TRACKING_CODE=true.
# It is only used by the old/static direct-login fallback.
SITE_TRACKING_CODE=
SITE_PASSCODE_2FA=
SITE_CAPTCHA_OUTPUT=

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_NEW_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
TELEGRAM_ALERT_CHAT_ID=

# Report
TARGET_COUNT=8300
TARGET_DEPOSIT=100000
REPORT_TIMEZONE=Asia/Kuala_Lumpur
REPORT_LINE_STYLE=full
STATE_PATH=/data/syabas_state.json

# Always-on worker + immediate session reclaim
RUN_FOREVER=true
SESSION_GUARD_ENABLED=true
SESSION_GUARD_SECONDS=15
AUTH_RELOGIN_RETRIES=5
REPORT_GRACE_SECONDS=60
REPORT_RETRY_SECONDS=30

# API / validation
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3
VALIDATION_RETRIES=3
VALIDATION_RETRY_DELAY_SECONDS=4
STRICT_FINAL_DAILY_VALIDATION=false
SHOW_VALIDATION_STATUS=false
DRY_RUN=false
FORCE_RUN=false

# Old pre-login mode is disabled
PRELOGIN_ENABLED=false
